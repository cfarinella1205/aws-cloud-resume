---
const links = [
  { href: "/", label: "Home" },
  { href: "/resume", label: "Resume" },
  { href: "/blog", label: "Blog" },
  { href: "/gallery", label: "Gallery" },
];
const currentPath = Astro.url.pathname;
---
<nav>
  <ul>
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class={currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? "active" : ""}
        >
          {link.label}
        </a>
      </li>
    ))}
    <li class="external-group">
      <a href="https://github.com/cfarinella1205" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/carson-farinella/" target="_blank" rel="noopener">LinkedIn</a>
    </li>
  </ul>
</nav>

<style>
  nav {
    margin-bottom: 3.5rem;
    padding: 1.15rem 0 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  a {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }
  a:hover { color: var(--ink); text-decoration: none; }
  a.active { color: var(--accent); }
  .external-group {
    margin-left: auto;
    display: flex;
    gap: 1.25rem;
  }
  @media (max-width: 520px) {
    .external-group { margin-left: 0; }
  }
</style>