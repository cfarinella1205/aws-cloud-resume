---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---
<BaseLayout title="Carson Farinella">
  <Nav />

  <main>
    <section class="hero">
      <p class="eyebrow">Based in Miami, FL</p>
      <h1>Carson<br /><em>Farinella</em></h1>
      <p class="tagline">
        Senior IT student at FIU, seeking opportunities in software engineering and cloud infrastructure. I enjoy building things that are polished, cost-effective, and functional. Safe to assume I'm working on at least three projects.
      </p>
    </section>

    <section class="now">
      <h2>What I'm working on</h2>
      <ul class="project-list">
        <li>
          <span class="project-label">This Website & My Homelab</span>
          <p>This site is a constant WIP, there are many improvements planned for the future and more bugs to squash with each new feature. My free time is equally taken up by maintaining and improving this site and refining or building out new homelab features. The most recent additions have been a solid workflow for adding new blog posts and Mealie in the homelab for recipe management and grocery planning.</p>
        </li>
        <li>
          <span class="project-label">Interview Prep</span>
          <p>Preparing for technical interviews in tandem with my final semester at FIU, and studying for the AWS CLF-C02 and SAA-C03 certifications. Focus is mainly geared towards AWS, systems design, and brushing up on Python/Bash/Linux.</p>
        </li>
        <li>
          <span class="project-label">RBAC Server</span>
          <p>Led a five-person student dev team as scrum master through five Agile sprints to design and build a role-based access control server for FIU's Senior Capstone II. Ran sprint planning and code review end to end, while owning the auth engine implementation. Shipped and live-demoed a working RBAC system during the Summer '26 FIU Capstone Showcase.</p>
        </li>
      </ul>
    </section>

    <section class="cta-row">
      <a href="/resume" class="cta-primary">View Resume</a>
      <a href="/blog" class="cta-secondary">Read the blog</a>
      <a href="mailto:cfarinella1205@outlook.com" class="cta-secondary">Get in touch</a>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
    <span class="marks" aria-hidden="true">
      <svg class="mark" data-mark="a" viewBox="0 0 12 12" width="11" height="11" focusable="false">
        <circle cx="6" cy="6" r="3.2" fill="currentColor" />
      </svg>
      <svg class="mark" data-mark="b" viewBox="0 0 12 12" width="11" height="11" focusable="false">
        <circle cx="6" cy="6" r="2.3" fill="currentColor" />
      </svg>
      <svg class="mark" data-mark="c" viewBox="0 0 12 12" width="11" height="11" focusable="false">
        <circle cx="6" cy="6" r="1.6" fill="currentColor" />
      </svg>
    </span>
    <a class="mark-link" href="/workbench" data-mark-link hidden>Workbench &rarr;</a>
  </footer>
</BaseLayout>

<script is:inline defer src="/scripts/footer-marks.js"></script>

<style>
  .hero {
    padding: 2rem 0 4rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3.5rem;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 6.5rem);   /* was 3.5rem floor — precautionary headroom at 320px, no change above ~440px */
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.75rem;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .tagline {
    max-width: 56ch;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .now {
    margin-bottom: 3.5rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--ink);
    margin-bottom: 1.75rem;
  }
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .project-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .project-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 0.25rem;
  }
  .project-list p {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.7;
  }
  /* Stack the label above its paragraph on phones — the 7.5rem label column
     otherwise squeezes body copy to ~117px (about 15 characters a line). */
  @media (max-width: 640px) {
    .project-list li { grid-template-columns: 1fr; gap: 0.35rem; }
    .project-label   { padding-top: 0; }
    .project-list    { gap: 2rem; }
  }

  .cta-row {
  display: flex;
  gap: 0.75rem 1.25rem;
  flex-wrap: wrap;
  align-items: center;
  padding-top: 1rem;
  border-top: 1px solid var(--rule);
  margin-bottom: 4rem;
}
  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .cta-primary:hover { opacity: 0.85; text-decoration: none; }
  .cta-secondary {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .cta-secondary {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 1px;
  white-space: nowrap;
  transition: color 0.15s, border-color 0.15s;
}

  /* Three actions as a deliberate vertical list instead of "two on a line,
     Get-in-touch orphaned below". */
  @media (max-width: 480px) {
    .cta-row { flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  }

  footer {
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }

  .marks {
    display: inline-flex;
    align-items: center;
    color: var(--rule);
  }
  .mark {
    display: block;
    /* Padding widens the tap target without scaling the glyph — the 11px
       width/height attributes are the content box. */
    box-sizing: content-box;
    padding: 6px;
    touch-action: manipulation;
    transition: color 0.2s ease;
  }
  .mark.is-lit { color: var(--muted); }

  .mark-link {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .mark-link[hidden] { display: none; }
  .mark-link.is-shown { opacity: 1; }
</style>