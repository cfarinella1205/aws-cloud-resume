---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap(post => post.data.tags ?? []))];

  return tags.map(tag => {
    const filtered = posts
      .filter(post => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return {
      params: { tag },
      props: { tag, posts: filtered },
    };
  });
}

const { tag, posts } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`#${tag} — Blog — Carson Farinella`} description={`Posts tagged "${tag}" on Carson Farinella's blog.`}>
  <Nav />

  <main>
    <header class="page-header">
      <a href="/blog" class="back">← All posts</a>
      <h1>#<em>{tag}</em></h1>
      <p class="subhead">{posts.length} post{posts.length === 1 ? "" : "s"} tagged “{tag}”.</p>
    </header>

    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`} class="post-link">
            <span class="post-date">{formatDate(post.data.date)}</span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-desc">{post.data.description}</span>
          </a>
          {post.data.tags && (
            <div class="post-tags">
              {post.data.tags.map((t: string) => (
                <a href={`/blog/tags/${t}`} class:list={["tag", { "tag-current": t === tag }]}>{t}</a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
  </footer>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  .back {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }
  .back:hover { color: var(--accent); text-decoration: none; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  h1 em { font-style: italic; color: var(--accent); }
  .subhead {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.75;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .post-list li {
    border-bottom: 1px solid var(--rule);
    padding: 1.75rem 0;
  }
  .post-link {
    display: grid;
    grid-template-columns: 10rem 1fr;
    grid-template-rows: auto auto;
    column-gap: 1.5rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .post-link:hover { opacity: 0.7; text-decoration: none; }

  .post-date {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    padding-top: 0.2rem;
    grid-row: 1;
    grid-column: 1;
  }
  .post-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--ink);
    grid-row: 1;
    grid-column: 2;
    line-height: 1.3;
  }
  .post-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
    grid-row: 2;
    grid-column: 2;
    margin-top: 0.4rem;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
    margin-left: calc(10rem + 1.5rem);
  }
  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .tag:hover { background: var(--accent); color: #fff; text-decoration: none; }
  .tag-current { background: var(--accent); color: #fff; }

  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 540px) {
    .post-link {
      grid-template-columns: 1fr;
    }
    .post-date { grid-column: 1; margin-bottom: 0.4rem; }
    .post-title { grid-column: 1; grid-row: 2; }
    .post-desc { grid-column: 1; grid-row: 3; }
    .post-tags { margin-left: 0; }
  }
</style>
