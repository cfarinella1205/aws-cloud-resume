---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${post.data.title} — Carson Farinella`} description={post.data.description}>
  <Nav />

  <main>
    <header class="post-header">
      <a href="/blog" class="back">← Blog</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span class="date">{formatDate(post.data.date)}</span>
        {post.data.tags && (
          <span class="tags">
            {post.data.tags.map((tag: string) => <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>)}
          </span>
        )}
      </div>
      <p class="description">{post.data.description}</p>
    </header>

    <article class="prose">
      <Content />
    </article>

    <footer>
      <a href="/blog" class="back-footer">← Back to all posts</a>
      <p class="sig">Carson Farinella · <a href="/">carsonfarinella.com</a></p>
    </footer>
  </main>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s;
  }
  .back:hover { color: var(--accent); text-decoration: none; }

  .post-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 0.85rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }
  .date {
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .tag:hover { background: var(--accent); color: #fff; text-decoration: none; }
  .description {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.75;
    max-width: 64ch;
    font-style: italic;
  }

  /* Prose styles for markdown content */
  .prose {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--ink);
    max-width: 73ch;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--ink);
    margin: 2.5rem 0 0.85rem;
  }
  .prose :global(h3) {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 2rem 0 0.6rem;
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--ink);
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.4rem;
    margin-bottom: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .prose :global(code) {
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.85em;
    background: #EDEAE4;
    color: var(--accent);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }
  .prose :global(pre) {
    background: #1A1A1A;
    color: #F7F5F1;
    padding: 1.25rem 1.5rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .prose :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2.5rem 0;
  }
  .prose :global(a) { color: var(--accent); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }

  footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .back-footer {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .back-footer:hover { color: var(--accent); text-decoration: none; }
  .sig {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1;
  }
</style>