---

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

---
<BaseLayout title="Blog — Carson Farinella" description="Writing about homelabs, cloud infrastructure, and building things.">
  <Nav />

  <main>
    <header class="page-header">
      <h1>Blog</h1>
      <p class="subhead">
        Notes on the things I am building.
        I am not a writer, you should only read this if you believe it contains the solution to a problem you are facing or trying to decide if you should hire me.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">Posts coming soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.id}`} class="post-link">
              <span class="post-date">{formatDate(post.data.date)}</span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
              {post.data.tags && (
                <span class="post-tags">
                  {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
  </footer>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .subhead {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 520px;
    line-height: 1.75;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .post-list li {
    border-bottom: 1px solid var(--rule);
  }
  .post-link {
    display: grid;
    grid-template-columns: 160px 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 1.5rem;
    padding: 1.75rem 0;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .post-link:hover { opacity: 0.7; text-decoration: none; }

  .post-date {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    padding-top: 0.2rem;
    grid-row: 1;
    grid-column: 1;
  }
  .post-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--ink);
    grid-row: 1;
    grid-column: 2;
    line-height: 1.3;
  }
  .post-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
    grid-row: 2;
    grid-column: 2;
    margin-top: 0.4rem;
  }
  .post-tags {
    grid-row: 3;
    grid-column: 2;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }
  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.15rem 0.45rem;
  }

  .empty {
    color: var(--muted);
    font-style: italic;
  }

  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--rule);
  }

  @media (max-width: 540px) {
    .post-link {
      grid-template-columns: 1fr;
    }
    .post-date { grid-column: 1; margin-bottom: 0.4rem; }
    .post-title { grid-column: 1; grid-row: 2; }
    .post-desc { grid-column: 1; grid-row: 3; }
    .post-tags { grid-column: 1; grid-row: 4; }
  }
</style>