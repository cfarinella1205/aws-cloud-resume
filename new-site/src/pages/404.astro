---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---
<BaseLayout title="Page Not Found — Carson Farinella" noindex>
  <Nav />

  <main>
    <section class="hero">
      <p class="eyebrow">Error 404</p>
      <h1>Nothing<br /><em>here.</em></h1>
      <p class="tagline">
        The page you're looking for doesn't exist, or it moved. Try the homepage,
        or one of the links below.
      </p>
    </section>

    <section class="cta-row">
      <a href="/" class="cta-primary">Back to Home</a>
      <a href="/blog" class="cta-secondary">Read the blog</a>
      <a href="/gallery" class="cta-secondary">View gallery</a>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
  </footer>
</BaseLayout>

<style>
  .hero {
    padding: 2rem 0 4rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3.5rem;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 6.5rem);   /* was 3.5rem floor — precautionary headroom at 320px, no change above ~440px */
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.75rem;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .tagline {
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .cta-row {
    display: flex;
    gap: 0.75rem 1.25rem;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    margin-bottom: 4rem;
  }
  .cta-primary {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.65rem 1.4rem;
    border-radius: 3px;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .cta-primary:hover { opacity: 0.85; text-decoration: none; }
  .cta-secondary {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }

  /* Three actions as a deliberate vertical list instead of "two on a line,
     the third orphaned below". */
  @media (max-width: 480px) {
    .cta-row { flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  }

  footer {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
