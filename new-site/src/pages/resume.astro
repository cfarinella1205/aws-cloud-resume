---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---
<BaseLayout title="Resume — Carson Farinella" description="Carson Farinella's resume — IT student, cloud enthusiast, aspiring solutions architect.">
  <Nav />

  <main>
    <header class="page-header">
      <h1>Resume</h1>
      <div class="header-links">
        <a href="mailto:cfarinella1205@outlook.com">cfarinella1205@outlook.com</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/carson-farinella" target="_blank" rel="noopener">LinkedIn</a>
        <span class="sep">·</span>
        <a href="https://github.com/cfarinella1205" target="_blank" rel="noopener">GitHub</a>
        <span class="sep">·</span>
        <span>Miami, FL</span>
      </div>
    </header>

    <section>
      <h2>Summary</h2>
      <p>
        Senior Information Technology student at <strong>Florida International University</strong>
        and active member of the <strong>FIU AWS Cloud Club</strong>. Driven by a fascination for high-availability
        systems and low-cost deployment, currently seeking a <strong>Solutions Architect Internship</strong> to apply my
        academic foundation in networking and automation to enterprise level challenges. Proven ability to translate
        complex technical requirements into functional cloud solutions.
      </p>
    </section>

    <section>
      <h2>Education & Leadership</h2>
      <div class="entry">
        <div class="entry-head">
          <span class="entry-title">B.S. in Information Technology</span>
          <span class="entry-date">Expected Dec 2026</span>
        </div>
        <div class="entry-sub">Florida International University (FIU)</div>
        <p><strong>Member:</strong> FIU AWS Cloud Club (Inaugural Term – Present)</p>
      </div>
      <div class="entry">
        <div class="entry-head">
          <span class="entry-title">Team Lead & Scrum Master — Senior Capstone II</span>
          <span class="entry-date">Summer 2026</span>
        </div>
        <p>Led a student development team through five Agile sprints to design and build a role-based access control (RBAC) server on an accelerated summer timeline.</p>
      </div>
    </section>

    <section>
      <h2>Certifications</h2>
      <div class="entry">
        <div class="entry-head">
          <span class="entry-title">AWS Certified Solutions Architect – Associate (SAA-C03)</span>
          <span class="entry-date">Expected Dec 2026</span>
        </div>
        <div class="entry-sub">Amazon Web Services · <em>In Progress</em></div>
      </div>
      <div class="entry">
        <div class="entry-head">
          <span class="entry-title">AWS Certified Cloud Practitioner (CLF-C02)</span>
          <span class="entry-date">Expected Sept 2026</span>
        </div>
        <div class="entry-sub">Amazon Web Services · <em>In Progress</em></div>
      </div>
    </section>

    <section>
      <h2>Projects</h2>
      <div class="entry project-entry">
        <div class="entry-head">
          <span class="entry-title">AWS Cloud Resume Challenge</span>
          <span class="entry-date">Completed</span>
        </div>
        <p>Serverless resume website demonstrating full-stack cloud competency and automated deployment.</p>
      </div>
      <div class="entry project-entry">
        <div class="entry-head">
          <span class="entry-title">Home Server & Homelab</span>
          <span class="entry-date">In Progress</span>
        </div>
        <p>Multi-device homelab running Home Assistant Core, a local LLM agent (Hermes), and containerized services via Docker, connected to the public internet through a Cloudflare Tunnel with no open router ports.</p>
      </div>
    </section>

    <section>
  <h2>Technical Skills</h2>
  <div class="skills-grid">
    <div class="skill-block">
      <strong>Languages</strong>
      <p>Python, JavaScript, HTML, CSS, Java, Bash</p>
    </div>
    <div class="skill-block">
      <strong>Cloud & Infrastructure</strong>
      <p>AWS (S3, CloudFront, Route 53, Lambda, DynamoDB), Infrastructure as Code (AWS SAM), CI/CD Pipelines, Docker</p>
    </div>
    <div class="skill-block">
      <strong>Networking & Security</strong>
      <p>TCP/IP, DNS, Network Architecture, Network Security, Cybersecurity Fundamentals, Cloudflare Tunnel, SSH</p>
    </div>
    <div class="skill-block">
      <strong>Systems & Tools</strong>
      <p>Linux, Android (Termux/proot), Git/GitHub, VS Code, Home Assistant, Local LLM deployment</p>
    </div>
    <div class="skill-block">
      <strong>Data & Automation</strong>
      <p>Database Administration, IT Automation, Scripting</p>
    </div>
  </div>
</section>
  </main>

  <footer>
    <div class="counter">
      Page views: <span id="counter">—</span>
    </div>
    <p class="footer-note">Carson Farinella · <a href="/">carsonfarinella.com</a></p>
  </footer>
</BaseLayout>

<script is:inline defer src="/scripts/visitor-counter.js"></script>

<style>
  main { padding-bottom: 3rem; }

  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .header-links {
  font-size: 0.875rem;
  color: var(--muted);
  display: flex;
  flex-wrap: wrap;
  gap: 0.15rem 0;
  align-items: center;
}
.header-links a { color: var(--accent); white-space: nowrap; }
.sep { margin: 0 0.4rem; color: var(--rule); flex-shrink: 0; }

  section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  section:last-of-type { border-bottom: none; }

  h2 {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  section > p {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 640px;
  }

  .entry { margin-bottom: 1.5rem; }
  .entry:last-child { margin-bottom: 0; }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }
  .entry-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .entry-date {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .entry-sub {
    font-size: 0.875rem;
    color: var(--muted);
    font-style: italic;
    margin-bottom: 0.4rem;
  }
  .entry ul, .project-entry ul {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.7;
  }
  .entry ul li, .project-entry ul li { margin-bottom: 0.3rem; }
  .project-entry > p {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
}
@media (max-width: 600px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }
}
  .skill-block strong {
    display: block;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  .skill-block p {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.65;
  }

  footer {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .counter {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .footer-note {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1;
  }

   @media print {
  @page { margin: 0.6in; }

  nav { display: none !important; }

  body {
    background: white !important;
    padding: 0 !important;
    border-left: none !important;
    max-width: 100% !important;
    margin: 0 !important;
    min-height: 0 !important;   /* undo 100vh floor so Edge doesn't spill a blank 2nd page */
    font-size: 10.5pt;
  }

  main { padding-bottom: 0 !important; }

  .page-header {
    padding-bottom: 0.6rem !important;
    margin-bottom: 0.9rem !important;
  }
  .page-header h1 {
    font-size: 22pt !important;
    margin-bottom: 0.35rem !important;
  }

  h2 {
    font-size: 8pt !important;
    border-bottom: 1px solid #ccc !important;
    color: #000 !important;
    margin-bottom: 0.5rem !important;
  }

  .entry-title { font-size: 10.5pt !important; }
  .entry-date { font-size: 9pt !important; }
  .entry-sub { font-size: 9pt !important; margin-bottom: 0.2rem !important; }

  /* Full printable width — undo the 640px screen reading measure */
  section > p { max-width: 100% !important; }
  section > p, .project-entry > p { font-size: 9.5pt !important; line-height: 1.45 !important; }

  section {
    border-bottom: none !important;
    margin-bottom: 0.7rem !important;
    padding-bottom: 0 !important;
    page-break-inside: auto;   /* allow a section to flow across a break */
  }

  /* Keep the small, atomic units from splitting instead of whole sections */
  .entry, .project-entry, .skill-block { page-break-inside: avoid; }
  .entry { margin-bottom: 0.6rem !important; }

  .skills-grid {
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 0.4rem 0.75rem !important;
  }

  .skill-block strong { font-size: 8pt !important; margin-bottom: 0.15rem !important; }
  .skill-block p { font-size: 9pt !important; line-height: 1.4 !important; }

  footer { display: none !important; }

  a { color: #000 !important; text-decoration: none !important; }
}
</style>