---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { Image, getImage } from "astro:assets";
import gallery from "../data/gallery.json";

import rbacImg from "../assets/gallery/rbac-terminal-log.png";
import awsImg from "../assets/gallery/aws-s3-bucket-objects.png";
import astroImg from "../assets/gallery/astro-github-actions-run.png";

type GalleryItem = {
  id: "rbac" | "aws" | "astro";
  order: string;
  title: string;
  caption: string;
  alt: string;
  post: string;
};

const items = gallery as GalleryItem[];
const sourceImages = { rbac: rbacImg, aws: awsImg, astro: astroImg };

// The lightbox shows a single full-resolution frame rather than the
// responsive <Image> srcset used inline, so precompute one large AVIF
// per item at build time and hand its URL to the client script via
// data-src.
const lightboxSrcs: Record<string, string> = {};
for (const [id, img] of Object.entries(sourceImages)) {
  const optimized = await getImage({ src: img, format: "avif", width: img.width });
  lightboxSrcs[id] = optimized.src;
}

const sizes = "(min-width: 1240px) 1040px, 90vw";
---
<BaseLayout title="Gallery — Carson Farinella" description="Images of the things Carson Farinella has built — take a look around.">
  <Nav />

  <main>
    <header class="page-header">
      <h1>Gallery</h1>
      <p class="subhead">
        Images of the things I've built. Take a look around — open any image
        for more detail.
      </p>
    </header>

    <div class="gallery-stack">
      {items.map((item, i) => (
        <section class="gallery-item reveal" aria-labelledby={`item-title-${item.id}`}>
          <div class="item-heading">
            <span class="item-index" aria-hidden="true">{item.order}</span>
            <h2 id={`item-title-${item.id}`}>{item.title}</h2>
          </div>

          <div class="item-media">
            <button
              class="lightbox-trigger"
              type="button"
              data-index={i}
              data-title={item.title}
              data-caption={item.caption}
              data-src={lightboxSrcs[item.id]}
              data-alt={item.alt}
              data-post={item.post ?? ""}
              aria-label={`View full-size: ${item.title}`}
            >
              <Image
                src={sourceImages[item.id]}
                alt={item.alt}
                widths={[720, 1160, 2320]}
                sizes={sizes}
                format="avif"
                loading={i === 0 ? "eager" : "lazy"}
                width={sourceImages[item.id].width}
                height={sourceImages[item.id].height}
              />
            </button>
          </div>

          <div class="item-caption">
            <p>{item.caption}</p>
            {item.post && (
              <a class="post-link" href={`/blog/${item.post}`}>Read the post &rarr;</a>
            )}
          </div>
        </section>
      ))}
    </div>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
  </footer>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lb-title" hidden>
    <div class="lightbox-backdrop" data-close></div>
    <figure class="lightbox-panel">
      <button class="lightbox-close" type="button" aria-label="Close" data-close>&times;</button>
      <div class="lightbox-media" id="lb-media"></div>
      <figcaption class="lightbox-caption">
        <h2 id="lb-title"></h2>
        <p id="lb-text"></p>
        <a id="lb-post" class="lightbox-post" href="#" hidden>Read the post &rarr;</a>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<script is:inline defer src="/scripts/gallery-lightbox.js"></script>

<style>
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .subhead {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 520px;
    line-height: 1.75;
  }

  .gallery-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 9vw, 7.5rem);
  }

  .gallery-item {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 550ms ease, transform 550ms ease;
  }
  .gallery-item.is-visible {
    opacity: 1;
    transform: none;
  }

  .item-heading {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .item-index {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .item-heading h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--ink);
  }

  .item-media {
    border: 1px solid var(--rule);
    background: var(--highlight);
  }
  .lightbox-trigger {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .lightbox-trigger:hover,
  .lightbox-trigger:focus-visible {
    opacity: 0.88;
  }
  .lightbox-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .lightbox-trigger :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(72vh, 760px);
    object-fit: contain;
  }

  .item-caption {
    max-width: 640px;
    margin-top: 1.25rem;
  }
  .item-caption p {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .post-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .post-link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2rem);
  }
  .lightbox[hidden] { display: none; }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(43, 36, 32, 0.72);
  }
  .lightbox-panel {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--rule);
    max-width: 96vw;
    max-height: 92svh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .lightbox-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    z-index: 1;
    background: var(--bg);
    border: 1px solid var(--rule);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    padding: 0.15rem 0.6rem;
    transition: color 0.15s;
  }
  .lightbox-close:hover { color: var(--ink); }
  .lightbox-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--highlight);
  }
  /* The lightbox <img> is injected at runtime by gallery-lightbox.js, so it
     never receives Astro's scoped-style attribute — :global() reaches it.
     A fixed viewport-unit cap on the image itself (rather than a percentage
     resolved through a flex parent) is what keeps this predictable across
     both very wide and very tall screenshots: object-fit: contain never has
     an ambiguous height to resolve against, so the image can't overflow into
     the caption below it. */
  .lightbox-media :global(img) {
    display: block;
    max-width: 100%;
    max-height: 68svh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox-caption {
    padding: 1.25rem 1.75rem 1.5rem;
  }
  .lightbox-caption h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .lightbox-caption p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 68ch;
  }
  .lightbox-post {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .lightbox-post[hidden] { display: none; }
  .lightbox-post:hover { border-color: var(--accent); text-decoration: none; }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
