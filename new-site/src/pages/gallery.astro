---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import { Image, getImage } from "astro:assets";
import gallery from "../data/gallery.json";

import rbacImg from "../assets/gallery/rbac-terminal-log.png";
import awsImg from "../assets/gallery/aws-s3-bucket-objects.png";
import astroImg from "../assets/gallery/before-after-astro.png";
import clfImg from "../assets/gallery/aws-clf-c02-certificate.png";

type GalleryItem = {
  id: "rbac" | "aws" | "astro" | "clf";
  order: string;
  title: string;
  caption: string;
  alt: string;
  post?: string;
  portrait?: boolean;   // phone screenshots: shown at phone width, centered
};

const items = gallery as GalleryItem[];
const sourceImages = { rbac: rbacImg, aws: awsImg, astro: astroImg, clf: clfImg };

// The lightbox shows a single full-resolution frame rather than the
// responsive <Image> srcset used inline, so precompute one large AVIF
// per item at build time and hand its URL to the client script via
// data-src.
const lightboxSrcs: Record<string, string> = {};
for (const [id, img] of Object.entries(sourceImages)) {
  const optimized = await getImage({ src: img, format: "avif", width: img.width });
  lightboxSrcs[id] = optimized.src;
}

const sizes = "(min-width: 1240px) 1040px, 90vw";
---
<BaseLayout title="Gallery — Carson Farinella" description="Images of the things Carson Farinella has built — take a look around.">
  <Nav />

  <main>
    <header class="page-header">
      <h1>Gallery</h1>
      <p class="subhead">
        Images of the things I've built. Click on any image to view a larger version in the lightbox, and if there's a related blog post, you'll find a link to it in the caption.
      </p>
    </header>

    <div class="gallery-stack">
      {items.map((item, i) => (
        <section class="gallery-item reveal" aria-labelledby={`item-title-${item.id}`}>
          <div class="item-heading">
            <span class="item-index" aria-hidden="true">{item.order}</span>
            <h2 id={`item-title-${item.id}`}>{item.title}</h2>
          </div>

          <div class={item.portrait ? "item-media is-portrait" : "item-media"}>
            <button
              class="lightbox-trigger"
              type="button"
              data-index={i}
              data-title={item.title}
              data-caption={item.caption}
              data-src={lightboxSrcs[item.id]}
              data-alt={item.alt}
              data-post={item.post ?? ""}
              aria-label={`View full-size: ${item.title}`}
            >
              <Image
                src={sourceImages[item.id]}
                alt={item.alt}
                widths={[720, 1160, 2320]}
                sizes={sizes}
                format="avif"
                loading={i === 0 ? "eager" : "lazy"}
                width={sourceImages[item.id].width}
                height={sourceImages[item.id].height}
              />
              <span class="expand-hint" aria-hidden="true">Tap to expand</span>
            </button>
          </div>

          <div class="item-caption">
            <p>{item.caption}</p>
            {item.post && (
              <a class="post-link" href={`/blog/${item.post}`}>Read the post &rarr;</a>
            )}
          </div>
        </section>
      ))}
    </div>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} Carson Farinella</p>
  </footer>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lb-title" hidden>
    <div class="lightbox-backdrop" data-close></div>
    <figure class="lightbox-panel">
      <button class="lightbox-close" type="button" aria-label="Close" data-close>&times;</button>
      <div class="lightbox-media" id="lb-media"></div>
      <span class="pan-hint" aria-hidden="true">Swipe to pan &rarr;</span>
      <figcaption class="lightbox-caption">
        <div class="lightbox-caption-head">
          <h2 id="lb-title"></h2>
          <button class="lightbox-caption-toggle" type="button" aria-expanded="false" aria-controls="lb-text">Caption</button>
        </div>
        <p id="lb-text"></p>
        <a id="lb-post" class="lightbox-post" href="#" hidden>Read the post &rarr;</a>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<script is:inline defer src="/scripts/gallery-lightbox.js"></script>

<!-- Items start hidden and gallery-lightbox.js fades them in. Without JS they'd
     stay invisible, so show them outright. is:inline keeps Astro from scoping
     this; !important beats the scoped .gallery-item[data-astro-cid] rule. -->
<noscript>
  <style is:inline>
    .gallery-item { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<style>
  .page-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .subhead {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.75;
  }

  .gallery-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 9vw, 7.5rem);
  }

  .gallery-item {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 550ms ease, transform 550ms ease;
  }
  .gallery-item.is-visible {
    opacity: 1;
    transform: none;
  }

  .item-heading {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .item-index {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .item-heading h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--ink);
  }

  .item-media {
    border: 1px solid var(--rule);
    background: var(--highlight);
  }
  .lightbox-trigger {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .lightbox-trigger:hover,
  .lightbox-trigger:focus-visible {
    opacity: 0.88;
  }
  .lightbox-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .lightbox-trigger :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(72vh, 760px);
    object-fit: contain;
  }

  /* Phone screenshots: full column width would blow a portrait capture up to
     ~2x its native size — hold it at phone width, centered in the frame. */
  .item-media.is-portrait .lightbox-trigger :global(img) {
    width: min(100%, 26rem);
    max-height: none;
    margin: 0 auto;
  }

  /* Only the phone layout shows this; see the mobile block below. */
  .expand-hint { display: none; }

  .item-caption {
    max-width: 640px;
    margin-top: 1.25rem;
  }
  .item-caption p {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .post-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .post-link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2rem);
  }
  .lightbox[hidden] { display: none; }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(43, 36, 32, 0.72);
  }
  .lightbox-panel {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--rule);
    max-width: 96vw;
    max-height: 92svh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .lightbox-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    z-index: 1;
    background: var(--bg);
    border: 1px solid var(--rule);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    padding: 0.15rem 0.6rem;
    transition: color 0.15s;
  }
  .lightbox-close:hover { color: var(--ink); }
  .lightbox-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--highlight);
  }
  /* The lightbox <img> is injected at runtime by gallery-lightbox.js, so it
     never receives Astro's scoped-style attribute — :global() reaches it.
     A fixed viewport-unit cap on the image itself (rather than a percentage
     resolved through a flex parent) is what keeps this predictable across
     both very wide and very tall screenshots: object-fit: contain never has
     an ambiguous height to resolve against, so the image can't overflow into
     the caption below it. */
  .lightbox-media :global(img) {
    display: block;
    max-width: 100%;
    max-height: 68svh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox-caption {
    padding: 1.25rem 1.75rem 1.5rem;
  }
  .lightbox-caption-toggle,
  .pan-hint { display: none; }
  .lightbox-caption h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .lightbox-caption p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 68ch;
  }
  .lightbox-post {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .lightbox-post[hidden] { display: none; }
  .lightbox-post:hover { border-color: var(--accent); text-decoration: none; }

  /* ---------------------------------------------------------------------------
     Phone (≤640px). Inline images are fit-to-width previews with a "tap to
     expand" badge; the lightbox becomes a full-screen viewer that shows the
     image at the viewer's full height and pans sideways, so a wide console
     capture is actually readable. Nothing here applies above 640px — the
     desktop gallery and lightbox are unchanged.
     --------------------------------------------------------------------------- */
  @media (max-width: 640px) {
    .item-heading h2 { font-size: 1.25rem; line-height: 1.25; }
    .lightbox-trigger { position: relative; }
    .lightbox-trigger :global(img) { max-height: none; }
    .expand-hint {
      display: block;
      position: absolute;
      right: 0.5rem;
      bottom: 0.5rem;
      padding: 0.3rem 0.6rem;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bg);
      background: rgba(43, 36, 32, 0.78);
    }
    .item-caption p { font-size: 1rem; }

    .lightbox { padding: 0; }
    .lightbox-panel {
      width: 100%;
      height: 100vh;                    /* fallback */
      height: 100dvh;                   /* tracks the collapsing mobile URL bar */
      max-width: none;
      max-height: none;
      border: 0;
    }
    .lightbox-close {
      top: 0.6rem;
      right: 0.6rem;
      width: 2.75rem;                   /* 44px tap target */
      height: 2.75rem;
      padding: 0;
      font-size: 1.9rem;
      color: var(--ink);
      box-shadow: 0 1px 6px rgba(43, 36, 32, 0.18);
    }
    /* The media area stops where the collapsed caption bar starts. --cap-h is
       that bar's measured height, set by gallery-lightbox.js on open; opening
       the caption then slides it up *over* the image instead of shrinking it. */
    .lightbox-media {
      height: calc(100% - var(--cap-h, 5rem));
      display: block;                   /* flex centering would clip the left edge of an overflowing image */
      overflow: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
    /* Fill the viewer's height; a wide capture overflows sideways and pans. */
    .lightbox-media :global(img) {
      height: 100%;
      width: auto;
      max-width: none;
      max-height: none;
      margin: 0 auto;                   /* centers a portrait capture that fits */
    }
    .pan-hint {
      position: absolute;
      left: 50%;
      top: 0.9rem;
      transform: translateX(-50%);
      padding: 0.35rem 0.75rem;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bg);
      background: rgba(43, 36, 32, 0.78);
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .lightbox-panel.can-pan .pan-hint {
      display: block;
      animation: pan-hint-out 0.4s ease 3s forwards;   /* gets out of the way on its own */
    }
    .lightbox-panel.has-panned .pan-hint { opacity: 0; }
    @keyframes pan-hint-out { to { opacity: 0; } }

    .lightbox-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: 70%;
      overflow-y: auto;
      padding: 0.6rem 1.25rem calc(0.9rem + env(safe-area-inset-bottom));
      background: var(--bg);
      border-top: 1px solid var(--rule);
    }
    .lightbox-panel.is-caption-open .lightbox-caption {
      box-shadow: 0 -8px 24px rgba(43, 36, 32, 0.16);
    }
    .lightbox-caption-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
    .lightbox-caption h2 { font-size: 1.15rem; line-height: 1.3; margin-bottom: 0; }
    .lightbox-caption-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      flex-shrink: 0;
      min-height: 2.75rem;
      background: none;
      border: 0;
      font: inherit;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      cursor: pointer;
    }
    .lightbox-caption-toggle::after { content: "\25B4"; }                        /* ▴ drawer opens upward */
    .lightbox-caption-toggle[aria-expanded="true"]::after { content: "\25BE"; }  /* ▾ */
    /* Collapsed by default so the image gets the screen; the same caption is
       already on the page right under the thumbnail. */
    .lightbox-caption p,
    .lightbox-post { display: none; }
    .lightbox-panel.is-caption-open .lightbox-caption p { display: block; margin-top: 0.5rem; font-size: 1rem; }
    .lightbox-panel.is-caption-open .lightbox-post:not([hidden]) { display: inline-block; }
  }

  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
