---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = "Carson Farinella — IT student, homelab builder, aspiring solutions architect.", noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Content-Security-Policy (defense-in-depth; version-controlled).
      frame-ancestors is intentionally omitted — it is ignored in a <meta> tag and
      is instead enforced via the X-Frame-Options response header at Cloudflare. */}
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://sg47t70dpa.execute-api.us-east-1.amazonaws.com; base-uri 'self'; form-action 'self';"
  />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
  --bg:        #F7F3EC;  /* warm cream */
  --ink:       #2B2420;  /* espresso, near-black */
  --muted:     #6B6055;  /* warm taupe, secondary text — darkened for WCAG AA contrast on --bg */
  --rule:      #E4DDD1;  /* hairline dividers */
  --highlight: #EFE9DE;  /* light fill */
  --accent:    #6B5744;  /* muted warm brown — links, italic name, small emphasis */
  --font-display: 'Fraunces', Georgia, serif;
  --font-body:    'Inter', system-ui, sans-serif;
}

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  /* Fluid root: holds at 16px (today's fixed value, unchanged) through
     ~1440px viewport width, then grows gently, capping at 18px around
     2560px so it never keeps scaling up on 4K displays. rem floor/ceiling
     (not px) so it also respects a user's browser default-font-size
     preference, per WCAG 1.4.4. Everything else in the site is sized in
     rem/ch relative to this, so the whole layout scales as one object. */
  font-size: clamp(1rem, 0.84rem + 0.18vw, 1.125rem);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

    body {
  min-height: 100svh;
  /* Signature: the vertical rule */
  border-left: 3px solid var(--accent);
  padding-left: clamp(2rem, 5vw, 5rem);
  padding-right: clamp(2rem, 5vw, 5rem);
  padding-top: 0;
  padding-bottom: 4rem;
  /* 75rem = 1200px at the 16px floor above — same container width as
     before at every viewport where the fluid root sits at its floor,
     now scaling with the root on wide/high-DPI monitors instead of
     staying frozen at a fixed pixel width. */
  max-width: 75rem;
  margin-left: auto;
  margin-right: auto;
}

    /* Mobile shell: at 320px the 2rem gutters + 3px rule eat ~67px of width and
       the rule sits glued to the screen edge. Reclaim ~25px, keep the signature. */
    @media (max-width: 640px) {
      body {
        border-left-width: 2px;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
        padding-bottom: 3rem;
      }
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }

    p { line-height: 1.75; color: var(--ink); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }

    /* Nav is a separate component, so page-scoped print rules can't reach it.
       Hide it globally when printing (resume PDF). */
    @media print {
      nav { display: none !important; }
    }
</style>
</head>
<body>
  <slot />
</body>
</html>